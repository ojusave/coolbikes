# Copy to .env. Do not commit .env.

ADYEN_API_KEY=
ADYEN_CLIENT_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_ENVIRONMENT=TEST

# Optional. HMAC for POST /api/webhooks. Leave unset until a webhook is configured.
# ADYEN_HMAC_KEY=

# Shop defaults when unset: NL, en-US, USD.
# SHOP_COUNTRY=NL
# SHOP_LOCALE=en-US
# SHOP_CURRENCY=USD

# The process listens on 0.0.0.0 and PORT. Render sets PORT.
# HOST=0.0.0.0
# PORT=4317
